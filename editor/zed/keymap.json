// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "shift shift": "file_finder::Toggle"
        }
    },
    {
        "bindings": {
            "ctrl-2": "git_panel::Toggle"
        }
    },
    {
        "bindings": {
            "ctrl-1": "project_panel::Toggle"
        }
    },
    {
        "bindings": {
            "ctrl-3": "collab_panel::Toggle"
        }
    },
    {
        "bindings": {
            "ctrl-4": "outline_panel::Toggle"
        }
    },
    {
        "bindings": {
            "ctrl-g": "git_graph::Open"
        }
    },
    {
        "bindings": {
            "alt-shift-r": "workspace::Reload"
        }
    },
    {
        "bindings": {
            "alt-r": "editor::ReloadFile"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-w": "workspace::CloseActiveDock"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-w": "workspace::CloseActiveDock"
        }
    },
    {
        "context": "Global",
        "bindings": {
            "ctrl-w": [
                "pane::CloseActiveItem",
                {
                    "close_pinned": false
                }
            ]
        }
    },
    {
        "bindings": {
            "ctrl-`": "workspace::NewCenterTerminal"
        }
    },
    {
        "bindings": {
            "ctrl-shift-`": ["task::Spawn", { "task_name": "claude code" }]
        }
    },
    {
        "bindings": {
            "ctrl-\\": [
                "workspace::SendKeystrokes",
                "ctrl-\\ ctrl-shift-` ctrl-option-t"
            ]
        }
    }
]
